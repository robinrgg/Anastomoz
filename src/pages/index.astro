---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Braids from '../components/Braids.astro';
import ContactCta from '../components/ContactCta.astro';
import { formatDate } from '../lib/date';
import { url } from '../lib/url';

import heroImage from '../assets/photos/retenue-bateau.jpg';
import inventaires from '../assets/photos/peche-electrique-groupe.jpg';
import plansEau from '../assets/photos/filets-demaillage.jpg';
import continuite from '../assets/photos/passe-a-poissons.jpg';
import gestion from '../assets/photos/gorges-vasque.jpg';
import neige from '../assets/photos/biometrie-neige.jpg';
import equipe from '../assets/photos/equipe-riviere.jpg';
import epuisettes from '../assets/photos/peche-electrique-epuisettes.jpg';

// Textes de maquette : à relire et valider.
const domaines = [
  {
    title: 'Inventaires piscicoles',
    text: 'Pêches électriques d’inventaire en cours d’eau, complètes ou partielles, selon des protocoles normalisés.',
    image: inventaires,
    alt: 'Une dizaine d’intervenants en waders progressent dans une rivière ombragée lors d’une pêche électrique.',
  },
  {
    title: 'Plans d’eau et retenues',
    text: 'Échantillonnage aux filets, suivis des peuplements lacustres, interventions en embarcation.',
    image: plansEau,
    alt: 'Un opérateur démaille des poissons pris dans un filet, sur une bâche étendue au bord d’une piste forestière.',
  },
  {
    title: 'Continuité écologique',
    text: 'Diagnostic des ouvrages, suivi de l’efficacité des dispositifs de franchissement piscicole.',
    image: continuite,
    alt: 'Passe à poissons à macro-rugosités : des rangées de plots cylindriques dans un courant clair, au bord d’une grande rivière.',
  },
  {
    title: 'Conseil et gestion halieutique',
    text: 'Accompagnement des gestionnaires et des structures de pêche, plans de gestion, expertise.',
    image: gestion,
    alt: 'Vasque turquoise au pied de hautes falaises calcaires couvertes de végétation.',
  },
];

const etapes = [
  {
    title: 'Observer',
    text: 'Des données de terrain fiables, collectées selon des protocoles reconnus, par tous les temps.',
  },
  {
    title: 'Analyser',
    text: 'Traitement, bancarisation et interprétation écologique des résultats, sans boîte noire.',
  },
  {
    title: 'Conseiller',
    text: 'Des recommandations concrètes, restituées clairement auprès des élus, techniciens et usagers.',
  },
];

const actualites = (await getCollection('actualites', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <!-- Bandeau d'accueil -->
  <section class="hero">
    <Image
      class="hero__image"
      src={heroImage}
      alt=""
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      quality={70}
    />
    <div class="container hero__content">
      <p class="eyebrow eyebrow--light">Bureau d’études · Milieux aquatiques · Poissons · Pêche</p>
      <h1>Comprendre les milieux aquatiques pour mieux les gérer.</h1>
      <p class="hero__lead">
        Inventaires piscicoles, suivis de plans d’eau, continuité écologique et conseil en gestion
        halieutique, au service des collectivités, des structures de pêche et des acteurs privés.
      </p>
      <div class="hero__actions">
        <a class="button button--accent" href={url('/prestations/')}>Nos prestations</a>
        <a class="button button--ghost" href={url('/contact/')}>Nous contacter</a>
      </div>
    </div>
    <Braids class="hero__braids" tone="dark" />
  </section>

  <!-- Le nom -->
  <section class="section">
    <div class="container definition">
      <div class="definition__term">
        <p class="definition__word">anastomose</p>
        <p class="definition__meta"><span>[a.na.stɔ.moz]</span> <em>n. f.</em></p>
      </div>
      <div>
        <p class="definition__text">
          En hydrologie, réseau de chenaux qui se séparent puis se rejoignent, façonnant des
          milieux riches et changeants.
        </p>
        <p class="lead">
          Chez nous, c’est surtout une façon de travailler : relier la connaissance scientifique,
          les gestionnaires et les usagers de l’eau autour d’un même cours d’eau.
        </p>
      </div>
    </div>
  </section>

  <!-- Domaines d'intervention -->
  <section class="section section--sand">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Domaines d’intervention</p>
          <h2>Du torrent de montagne à la grande retenue</h2>
        </div>
        <a class="link-arrow" href={url('/prestations/')}>Toutes nos prestations</a>
      </div>
      <ul class="domaines">
        {
          domaines.map((domaine) => (
            <li class="domaine">
              <Image
                src={domaine.image}
                alt={domaine.alt}
                widths={[400, 640, 900]}
                sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw"
                quality={70}
              />
              <div class="domaine__body">
                <h3>{domaine.title}</h3>
                <p>{domaine.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Terrain -->
  <section class="section">
    <div class="container terrain">
      <div class="terrain__text">
        <p class="eyebrow">Sur le terrain</p>
        <h2>En toutes saisons, les pieds dans l’eau</h2>
        <p class="lead">
          Une équipe de techniciens et d’ingénieurs habitués aux conditions réelles : rivières
          de montagne sous la neige, retenues en fin d’été, cours d’eau méditerranéens.
        </p>
        <a class="link-arrow" href={url('/equipe/')}>Découvrir l’équipe</a>
      </div>
      <div class="mosaic">
        <Image
          class="mosaic__a"
          src={neige}
          alt="Un technicien saisit des mesures sur une tablette, à une table installée dans la neige au bord d’un torrent."
          widths={[480, 800, 1200]}
          sizes="(min-width: 64rem) 36vw, 100vw"
          quality={70}
        />
        <Image
          class="mosaic__b"
          src={equipe}
          alt="L’équipe pose dans une rivière, en waders, avec épuisettes et anode de pêche électrique."
          widths={[400, 640]}
          sizes="(min-width: 64rem) 20vw, 50vw"
          quality={70}
        />
        <Image
          class="mosaic__c"
          src={epuisettes}
          alt="Trois intervenants manient des épuisettes dans une eau claire au fond de galets."
          widths={[400, 640]}
          sizes="(min-width: 64rem) 20vw, 50vw"
          quality={70}
        />
      </div>
    </div>
  </section>

  <!-- Approche -->
  <section class="section section--navy">
    <div class="container">
      <p class="eyebrow eyebrow--light">Notre approche</p>
      <h2>De la donnée à la décision</h2>
      <ol class="etapes">
        {
          etapes.map((etape, i) => (
            <li>
              <span class="etapes__num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{etape.title}</h3>
              <p>{etape.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Données ouvertes -->
  <section class="section">
    <div class="container donnees">
      <div>
        <p class="eyebrow">Données ouvertes</p>
        <h2>Les rivières en chiffres</h2>
        <p class="lead">
          Bientôt sur ce site : une carte interactive des données piscicoles et de qualité des
          eaux publiées par les services publics via Hub’Eau.
        </p>
      </div>
      <Braids class="donnees__braids" />
    </div>
  </section>

  <!-- Actualités -->
  {
    actualites.length > 0 && (
      <section class="section section--sand">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Actualités</p>
              <h2>Dernières nouvelles</h2>
            </div>
            <a class="link-arrow" href={url('/actualites/')}>Toutes les actualités</a>
          </div>
          <ul class="news">
            {actualites.map((article) => (
              <li class="news__item">
                {article.data.image && (
                  <Image
                    src={article.data.image}
                    alt=""
                    widths={[400, 640]}
                    sizes="(min-width: 64rem) 33vw, 100vw"
                    quality={70}
                  />
                )}
                <p class="news__date">
                  <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
                </p>
                <h3>
                  <a href={url(`/actualites/${article.id}/`)}>{article.data.title}</a>
                </h3>
                <p>{article.data.description}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <ContactCta />
</BaseLayout>

<style>
  /* ---------- Bandeau ---------- */
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(88vh, 52rem);
    overflow: hidden;
    color: var(--color-white);
    background: var(--color-navy-900);
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 70%;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(8 38 64 / 0.88) 0%, rgb(8 38 64 / 0.55) 45%, rgb(8 38 64 / 0.05) 80%),
      linear-gradient(0deg, rgb(8 38 64 / 0.7) 0%, transparent 35%);
  }

  @media (max-width: 56rem) {
    .hero::after {
      background: linear-gradient(180deg, rgb(8 38 64 / 0.8) 0%, rgb(8 38 64 / 0.7) 60%, rgb(8 38 64 / 0.85) 100%);
    }
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: var(--space-7) calc(var(--space-7) + 2rem);
  }

  .hero__content > * {
    max-width: 36rem;
  }

  .hero h1 {
    font-size: clamp(2.5rem, 1.6rem + 3vw, 4rem);
    color: var(--color-white);
    font-weight: 400;
  }

  .hero__lead {
    max-width: 38rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--color-foam-100);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .hero :global(.hero__braids) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-3);
    z-index: 1;
  }

  .eyebrow--light {
    color: var(--color-mist-300);
  }

  /* ---------- Définition ---------- */
  .definition {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .definition {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-6);
    }
  }

  .definition__word {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-style: italic;
    font-weight: 300;
    line-height: 1;
    color: var(--color-navy-700);
  }

  .definition__meta {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }

  .definition__meta span {
    margin-right: var(--space-2);
    color: var(--color-sand-700);
    font-weight: 600;
  }

  .definition__text {
    padding-left: var(--space-4);
    border-left: 3px solid var(--color-sand-500);
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--color-navy-700);
  }

  /* ---------- En-têtes de section ---------- */
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .section-head h2 {
    margin: 0;
  }

  /* ---------- Domaines ---------- */
  .domaines {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .domaines {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .domaines {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .domaine {
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow);
  }

  .domaine img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .domaine__body {
    padding: var(--space-4);
  }

  .domaine__body p {
    margin: 0;
    color: var(--color-text-muted);
  }

  /* ---------- Terrain ---------- */
  .terrain {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .terrain {
      grid-template-columns: 4fr 7fr;
      gap: var(--space-6);
    }
  }

  .mosaic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .mosaic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .mosaic :global(.mosaic__a) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  .mosaic :global(.mosaic__b),
  .mosaic :global(.mosaic__c) {
    aspect-ratio: 4 / 3;
  }

  /* ---------- Approche ---------- */
  .etapes {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .etapes {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .etapes li {
    padding-top: var(--space-4);
    border-top: 1px solid rgb(168 184 196 / 0.35);
  }

  .etapes__num {
    display: block;
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 300;
    line-height: 1;
    color: var(--color-sand-500);
  }

  .etapes p {
    margin: 0;
    color: var(--color-mist-300);
  }

  /* ---------- Données ---------- */
  .donnees {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .donnees {
      grid-template-columns: 1fr 1fr;
    }
  }

  .donnees :global(.donnees__braids) {
    height: clamp(6rem, 12vw, 10rem);
  }

  /* ---------- Actualités ---------- */
  .news {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .news {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .news__item img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: var(--space-3);
  }

  .news__date {
    margin-bottom: var(--space-2);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .news__item h3 a {
    color: inherit;
    text-decoration: none;
  }

  .news__item h3 a:hover {
    text-decoration: underline;
  }
</style>
