---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Page introuvable">
  <PageHeader eyebrow="Erreur 404" title="Ce chenal ne mène nulle part" lead="La page demandée n’existe pas ou a été déplacée." />
  <section class="section">
    <div class="container">
      <a class="button button--primary" href={url('/')}>Retour à l’accueil</a>
    </div>
  </section>
</BaseLayout>
