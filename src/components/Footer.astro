---
import { legalLinks, site } from '../data/site';
import { url } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>
      <strong>{site.name}</strong> — {site.tagline}
    </p>
    <ul>
      {
        legalLinks.map((item) => (
          <li>
            <a href={url(item.href)}>{item.label}</a>
          </li>
        ))
      }
    </ul>
    <p class="copyright">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6);
    background: var(--color-navy-deep);
    color: var(--color-foam);
  }

  .site-footer__inner {
    padding-block: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }

  p {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--color-white);
  }

  .copyright {
    color: var(--color-mist);
    font-size: 0.875rem;
  }
</style>
