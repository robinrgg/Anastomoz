---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Braids from './Braids.astro';

// En-tête commun des pages intérieures : photo de fond (facultative),
// surtitre, titre et chapô, avec le motif de chenaux en bas.
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  image?: ImageMetadata;
  /** Position du cadrage de la photo (CSS object-position). */
  focus?: 'top' | 'center' | 'bottom';
}

const { title, eyebrow, lead, image, focus = 'center' } = Astro.props;
---

<header class:list={['page-header', image ? 'page-header--image' : 'page-header--plain']}>
  {
    image && (
      <Image
        class:list={['page-header__image', `focus-${focus}`]}
        src={image}
        alt=""
        widths={[640, 1024, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        quality={70}
      />
    )
  }
  <div class="container page-header__content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="page-header__lead">{lead}</p>}
  </div>
  <Braids class="page-header__braids" tone={image ? 'dark' : 'light'} />
</header>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-6) calc(var(--space-6) + 2rem);
  }

  .page-header--plain {
    background: var(--color-sand-100);
  }

  .page-header--image {
    display: grid;
    align-items: end;
    min-height: min(60vh, 32rem);
    background: var(--color-navy-900);
    color: var(--color-white);
  }

  .page-header__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .focus-top {
    object-position: center 20%;
  }

  .focus-center {
    object-position: center;
  }

  .focus-bottom {
    object-position: center 80%;
  }

  .page-header--image::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(8 38 64 / 0.85) 0%, rgb(8 38 64 / 0.45) 55%, rgb(8 38 64 / 0.15) 100%),
      linear-gradient(0deg, rgb(8 38 64 / 0.75) 0%, transparent 50%);
  }

  .page-header__content {
    position: relative;
    z-index: 1;
  }

  .page-header__content > * {
    max-width: 44rem;
  }

  h1 {
    margin-bottom: var(--space-3);
    font-size: var(--step-4);
    font-weight: 400;
  }

  .page-header--image h1 {
    color: var(--color-white);
  }

  .page-header--image .eyebrow {
    color: var(--color-mist-300);
  }

  .page-header__lead {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .page-header--image .page-header__lead {
    color: var(--color-foam-100);
  }

  .page-header :global(.page-header__braids) {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-3);
    z-index: 1;
  }
</style>
